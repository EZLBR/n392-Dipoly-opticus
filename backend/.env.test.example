# ============================================================
#   Variáveis para a suíte de testes do backend
#   Copie para .env.test e ajuste ao seu ambiente.
#
#   ⚠️ O banco PRECISA terminar em "_test". A suíte se recusa a
#   rodar fora disso (guard assertBancoDeTeste em tests/setup/db.ts)
#   porque os testes de integração executam operações destrutivas
#   no schema: `prisma db push --accept-data-loss` e
#   `DROP SCHEMA public CASCADE`. Nunca aponte para um banco real.
# ============================================================

NODE_ENV=test

# Banco dedicado aos testes, separado do de desenvolvimento.
#   createdb opticus_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opticus_test

# Qualquer valor serve; precisa apenas existir e ser estável na execução.
JWT_SECRET=segredo-apenas-para-testes-nao-use-em-producao

# Deixe em branco: mantém o gateway de pagamento no modo simulado.
ABACATE_TOKEN=
