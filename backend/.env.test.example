# ============================================================
#   Variáveis para a suíte de testes do backend
#   Copie para .env.test e ajuste ao seu ambiente.
#
#   ⚠️ O banco PRECISA terminar em "_test". O setup de testes
#   aplica as migrations com `prisma migrate deploy` e a guarda
#   assertBancoDeTeste (tests/setup/db.ts) se recusa a rodar
#   fora disso. Os testes executam TRUNCATE destrutivo.
#   Nunca aponte para um banco real.
# ============================================================

NODE_ENV=test
PORT=5000
FRONTEND_URL=http://localhost:5173

# Banco dedicado aos testes, separado do de desenvolvimento.
#   createdb opticus_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opticus_test

# Qualquer valor serve; precisa apenas existir e ser estável na execução.
JWT_SECRET=segredo-apenas-para-testes-nao-use-em-producao

# Obrigatória (SEC-04). O placeholder mantém o gateway no modo simulado;
# testes que exercitam o gateway real fazem stub do token em tempo de execução.
ABACATE_TOKEN=your_abacatepay_token_here
