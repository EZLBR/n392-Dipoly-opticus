# ============================================================
#   OPTICUS BACKEND — Variáveis de Ambiente (Exemplo)
#   Copie este arquivo para .env e preencha com seus dados
#
#   Nunca coloque credenciais reais neste arquivo.
# ============================================================

# ── Banco de Dados PostgreSQL ───────────────────────────────
# Obrigatória em todos os ambientes; usada pelo Prisma e pela camada pg legada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opticus_db
DB_SSL=false

# ── Autenticação JWT ────────────────────────────────────────
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ── Pagamentos AbacatePay (deixe em branco para usar simulador) ──
ABACATE_TOKEN=

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
