# ============================================================
#   OPTICUS BACKEND — Variáveis de Ambiente (Exemplo)
#   Copie este arquivo para .env e preencha com seus dados
#
#   Nunca coloque credenciais reais neste arquivo.
# ============================================================

# ── Banco de Dados PostgreSQL ───────────────────────────────
# PostgreSQL 14+. DATABASE_URL é obrigatória e usada pelo Prisma e pelo pool pg.
# Valor de exemplo apenas — nunca use no seu ambiente.
DATABASE_URL="postgresql://user:password@localhost:5432/opticus_db?schema=public"
DB_SSL=false

# ── Seed: usuário staff inicial (OPCIONAL) ──────────────────
# Se definidas na produção/deploy, o seed (npx prisma db seed) garante
# um usuário staff. Se ausentes, o seed PULA a criação — nunca há senha
# ou conta admin padrão no código.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD_HASH=

# ── Autenticação JWT ────────────────────────────────────────
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ── Pagamentos AbacatePay (deixe em branco para usar simulador) ──
ABACATE_TOKEN=

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
