# ============================================================
#   OPTICUS BACKEND — Variáveis de Ambiente (Exemplo)
#   Copie este arquivo para .env e preencha com seus dados
#
#   Nunca coloque credenciais reais neste arquivo.
# ============================================================

# ── Banco de Dados PostgreSQL ───────────────────────────────
# Prefira DATABASE_URL em produção. As variáveis separadas são úteis localmente.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=opticus_db
DB_SSL=false

# ── Autenticação JWT ────────────────────────────────────────
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ── Pagamentos AbacatePay (deixe em branco para usar simulador) ──
ABACATE_TOKEN=

# ── Servidor ────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173
