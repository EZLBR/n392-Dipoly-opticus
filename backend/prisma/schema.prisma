datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(100)
  descricao String?   @db.Text
  criadoEm  DateTime? @default(now()) @map("criado_em")

  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  produtos Produto[]

  @@map("categorias")
}

enum Role {
  client
  factory
  staff
}

model Usuario {
  id          Int       @id @default(autoincrement())
  nome        String    @db.VarChar(255)
  email       String    @unique @db.VarChar(255)
  senhaHash   String    @map("senha_hash") @db.VarChar(255)
  resetTokenHash String? @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  /// Tokens JWT emitidos antes deste instante são recusados (troca de senha).
  sessoesValidasDesde DateTime? @map("sessoes_validas_desde")
  role        Role?     @default(client)
  factoryName String?   @map("factory_name") @db.VarChar(255)
  criadoEm    DateTime? @default(now()) @map("criado_em")

  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  googleSubject String? @unique @map("google_subject") @db.VarChar(255)

  pedidos        Pedido[]      @relation("UsuarioPedidos")
  pedidosFabrica Pedido[]      @relation("FactoryPedidos")
  savedDesigns   SavedDesign[]
  studioAssets   StudioAsset[]
  carrinho       CarrinhoItem[]

  @@map("usuarios")
}

model Produto {
  id          Int       @id @default(autoincrement())
  nome        String    @db.VarChar(255)
  descricao   String?   @db.Text
  preco       Decimal   @db.Decimal(10, 2)
  categoriaId Int?      @map("categoria_id")
  imagemUrl   String?   @map("imagem_url") @db.VarChar(500)
  ativo       Boolean?  @default(true)
  criadoEm    DateTime? @default(now()) @map("criado_em")

  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  categoria Categoria?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  itens     PedidoItem[]
  estoque   Estoque?

  @@index([categoriaId], map: "idx_produtos_categoria")
  @@map("produtos")
}

enum PedidoStatus {
  Pending_Payment @map("Pending Payment")
  Queued
  In_production   @map("In production")
  Delivered
  Cancelled
}

model Pedido {
  id               Int           @id @default(autoincrement())
  usuarioId        Int           @map("usuario_id")
  customerName     String        @map("customer_name") @db.VarChar(255)
  customerEmail    String        @map("customer_email") @db.VarChar(255)
  productName      String        @map("product_name") @db.VarChar(255)
  factoryId        Int?          @map("factory_id")
  factoryName      String?       @map("factory_name") @db.VarChar(255)
  status           PedidoStatus? @default(Pending_Payment)
  total            Decimal       @db.Decimal(10, 2)
  customSpecs      String?       @map("custom_specs") @db.Text
  abacateBillingId String?       @map("abacate_billing_id") @db.VarChar(255)
  pagamentoSimulado Boolean     @default(false) @map("pagamento_simulado")
  criadoEm         DateTime?     @default(now()) @map("criado_em")
  atualizadoEm     DateTime?     @default(now()) @map("atualizado_em")

  version  Int    @default(0)
  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  usuario    Usuario      @relation("UsuarioPedidos", fields: [usuarioId], references: [id], onDelete: Cascade)
  fabrica    Usuario?     @relation("FactoryPedidos", fields: [factoryId], references: [id], onDelete: SetNull)
  itens      PedidoItem[]
  pagamentos Pagamento[]
  statusHistory OrderStatusHistory[]
  itensDoCarrinho CarrinhoItem[]

  @@index([usuarioId], map: "idx_pedidos_usuario")
  @@index([factoryId], map: "idx_pedidos_factory")
  @@index([status], map: "idx_pedidos_status")
  @@index([abacateBillingId], map: "idx_pedidos_billing")
  @@map("pedidos")
}

enum OrderHistoryKind {
  baseline
  created
  transition
}

model OrderStatusHistory {
  id         BigInt           @id @default(autoincrement())
  orderId    Int              @map("order_id")
  kind       OrderHistoryKind
  fromStatus PedidoStatus?    @map("from_status")
  toStatus   PedidoStatus?    @map("to_status")
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  order Pedido @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, id], map: "idx_order_status_history_order_id")
  @@map("order_status_history")
}

/// Reservada para a FEAT-04 (#48), que a remodela: veja docs/decisions/ADR-0004.
/// Até lá, nenhum código lê nem grava esta tabela.
model PedidoItem {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int     @default(1)
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId], map: "idx_itens_pedido")
  @@index([produtoId], map: "idx_itens_produto")
  @@map("pedido_itens")
}

model Estoque {
  id            Int       @id @default(autoincrement())
  produtoId     Int       @unique @map("produto_id")
  quantidade    Int       @default(0)
  estoqueMinimo Int?      @default(5) @map("estoque_minimo")
  atualizadoEm  DateTime? @default(now()) @map("atualizado_em")

  version  Int    @default(0)
  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("estoque")
}

enum MetodoPagamento {
  pix
  cartao_credito
  boleto
}

enum StatusPagamento {
  pendente
  aprovado
  recusado
  estornado
}

model Pagamento {
  id                Int              @id @default(autoincrement())
  pedidoId          Int              @map("pedido_id")
  metodo            MetodoPagamento? @default(pix)
  status            StatusPagamento? @default(pendente)
  valor             Decimal          @db.Decimal(10, 2)
  referenciaExterna String?          @map("referencia_externa") @db.VarChar(255)
  criadoEm          DateTime?        @default(now()) @map("criado_em")

  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId], map: "idx_pagamentos_pedido")
  @@map("pagamentos")
}

model SavedDesign {
  id             String    @id @db.VarChar(255)
  usuarioId      Int       @map("usuario_id")
  name           String    @db.VarChar(255)
  model          String    @db.VarChar(255)
  color          String    @db.VarChar(50)
  isSunglasses   Boolean?  @default(false) @map("is_sunglasses")
  antiReflective Boolean?  @default(false) @map("anti_reflective")
  templeStyle    String?   @default("standard") @map("temple_style") @db.VarChar(50)
  topBar         Boolean?  @default(false) @map("top_bar")
  bridgeStyle    String?   @default("keyhole") @map("bridge_style") @db.VarChar(50)
  frameProfile   String?   @default("medium") @map("frame_profile") @db.VarChar(50)
  templeOpen     Decimal?  @default(0.00) @map("temple_open") @db.Decimal(4, 2)
  published      Boolean?  @default(false)
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")
  studioConfig   Json?     @map("studio_config") @db.JsonB

  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  assets  StudioDesignAsset[]

  @@index([usuarioId], map: "idx_designs_usuario")
  @@map("saved_designs")
}

model StudioAsset {
  id        String   @id @db.Uuid
  usuarioId Int?     @map("usuario_id")
  width     Int
  height    Int
  bytes     Int
  state     String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  usuario Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  designs StudioDesignAsset[]

  @@index([usuarioId])
  @@map("studio_assets")
}

model StudioDesignAsset {
  designId String @map("design_id") @db.VarChar(255)
  assetId  String @map("asset_id") @db.Uuid

  design SavedDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  asset  StudioAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([designId, assetId])
  @@index([assetId])
  @@map("studio_design_assets")
}

/// CART-01 (#115): o carrinho de cada conta. Cada linha é um item com uma
/// configuração; a mesma configuração soma quantidade na mesma linha (chave).
/// pedidoId é o pedido que o último checkout criou para a linha: quando o
/// pagamento dele é confirmado, a linha sai do carrinho.
model CarrinhoItem {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @map("usuario_id")
  /// SHA-256 da configuração (produto, fábrica e especificações), em hexadecimal.
  chave           String   @db.VarChar(64)
  productName     String   @map("product_name") @db.VarChar(255)
  factoryPublicId String?  @map("factory_public_id") @db.VarChar(64)
  factoryName     String   @map("factory_name") @db.VarChar(255)
  customSpecs     Json     @map("custom_specs") @db.JsonB
  quantidade      Int
  /// Sobe a cada mudança feita pelo cliente; o checkout só vincula a versão que leu.
  versao          Int      @default(0)
  pedidoId        Int?     @map("pedido_id")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  publicId String @unique @default(dbgenerated("gen_random_uuid()"))

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedido  Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, chave], map: "carrinho_itens_usuario_chave_key")
  @@index([pedidoId], map: "idx_carrinho_itens_pedido")
  @@map("carrinho_itens")
}
