# ============================================================
#   OPTICUS — variáveis da stack Docker Compose
#
#   cp .env.example .env
#
#   Preencha os dois campos obrigatórios. O .env NUNCA é versionado.
#   Sem eles, `docker compose up` para com uma mensagem dizendo o que
#   falta — a stack não sobe com segredo vazio.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=opticus
POSTGRES_DB=opticus

# OBRIGATÓRIA. A senha entra na DATABASE_URL: use só letras e números,
# ou caracteres especiais quebram a URL. Para gerar uma:
#   openssl rand -hex 24
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# ── API ─────────────────────────────────────────────────────
# OBRIGATÓRIA. Assina os tokens de login. Para gerar uma:
#   openssl rand -hex 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcional. Vazio mantém o pagamento em modo simulado.
ABACATE_TOKEN=

# ── Administrador inicial (opcional) ────────────────────────
# Sem os dois valores, nenhuma conta staff é criada.
# O hash é bcrypt e contém "$": use ASPAS SIMPLES, senão o Compose
# tenta interpolar e corrompe o valor. Exemplo:
#   SEED_ADMIN_PASSWORD_HASH='$2b$10$...'
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH=

# ── Portas no host (sempre em 127.0.0.1) ────────────────────
API_PORT=5000
WEB_PORT=8080
# 5433 para não colidir com um PostgreSQL já instalado na 5432.
DB_PORT=5433
